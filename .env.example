# Đổi tên file này thành .env và điền giá trị thật (không commit .env lên git)

SECRET_KEY=doi-chuoi-nay-thanh-mot-chuoi-bi-mat-ngau-nhien
SESSION_COOKIE_SECURE=false

# Vercel: liên kết PostgreSQL và dùng DATABASE_URL (hoặc POSTGRES_URL).
# Local mặc định dùng SQLite trong instance/.
# DATABASE_URL=

# Tệp riêng chứa 8 tài khoản (script tạo file này, không commit lên git).
# MEMBER_ACCOUNTS_FILE=member_accounts.json
# Trên Vercel có thể lưu toàn bộ nội dung JSON trong biến bí mật này.
# MEMBER_ACCOUNTS_JSON=

# Đặt đường dẫn này trên ổ đĩa bền vững của hosting để giữ mục tiêu cá nhân.
# Ví dụ Render Disk mount tại /var/data:
# PERSONAL_GOALS_DB_PATH=/var/data/dlt4_personal_goals.sqlite3

# ID lấy từ URL của Google Sheet:
# https://docs.google.com/spreadsheets/d/ĐOẠN_NÀY_LÀ_ID/edit
GOOGLE_SHEET_ID=1IX_oVd3M6Anz2zTkFwxK02lWYQXhK-rFv70YgUtVH5Q

# Tên 2 tab sẽ được tự tạo trong Sheet để lưu dữ liệu nhập từ web
SHEET_TAB_TAO_DO=Data_TaoDo
SHEET_TAB_TAO_XANH=Data_TaoXanh
MASTER_SHEET_TAB=Bảng thông tin trái quả

# Đường dẫn tới file service account key (tải từ Google Cloud Console)
# Local: mặc định app sẽ tìm tại dlt4/credentials.json.
# Deploy: đổi thành đường dẫn secret file của nền tảng, ví dụ:
# GOOGLE_CREDENTIALS_PATH=/etc/secrets/credentials.json
GOOGLE_CREDENTIALS_PATH=
# Trên Vercel có thể lưu toàn bộ JSON service account trong biến bí mật này.
# GOOGLE_CREDENTIALS_JSON=

# (Tuỳ chọn) Danh sách tên người nhập gợi ý, cách nhau bởi dấu phẩy
NGUOI_NHAP_LIST=CT,NTDN,PTTT,LNQN,PTV,PMP,NHĐ,PTKA
